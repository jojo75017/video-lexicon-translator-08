{
  "manifest_version": 3,
  "name": "EbookStudio Scanner — Niches KDP",
  "version": "1.2.0",
  "description": "Analyse de niche KDP : score /100, ASIN, titre, auteur, BSR, prix, avis, ventes & revenus estimés, mots-clés, historique avec export CSV. Multi-marketplaces.",
  "permissions": ["activeTab", "storage", "scripting", "tabs"],
  "host_permissions": [
    "https://www.amazon.fr/*",
    "https://www.amazon.com/*",
    "https://www.amazon.co.uk/*",
    "https://www.amazon.de/*",
    "https://www.amazon.es/*",
    "https://www.amazon.it/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "EbookStudio Scanner",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.fr/*",
        "https://www.amazon.com/*",
        "https://www.amazon.co.uk/*",
        "https://www.amazon.de/*",
        "https://www.amazon.es/*",
        "https://www.amazon.it/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
